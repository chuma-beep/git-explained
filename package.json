{
  "name": "git-switchyard",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "node tools/build-all.mjs",
    "test": "npm run build && npm run test:figures && npm run test:docs",
    "test:figures": "node tools/audit.mjs",
    "test:docs": "python3 tools/ste_check.py --mode mixed --word-list tools/word-list.md docs/*.md",
    "vendor": "node vendor-kit.mjs",
    "watch": "node watch.mjs",
    "dev": "node watch.mjs & vite",
    "dev:serve": "vite",
    "serve": "python3 -m http.server 8000"
  },
  "devDependencies": {
    "vite": "^6.0.0"
  }
}